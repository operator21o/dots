{ pkgs, stateVersion, ... }:
{
  imports = [
    ./modules/home/niri.nix
  ];

  home.username = "rabbit";
  home.homeDirectory = "/home/rabbit";

  home.packages = with pkgs; [
    nodejs_22
    swaybg

    # python
    (python3.withPackages (ps: [
      ps.tkinter
    ]))
    # discord
    vesktop
  ];

  # aliases
  programs.bash = {
    enable = true;

    shellAliases = {
      idle = "python3 -m idlelib"; # launch IDLE
      homeswitch = "home-manager switch --flake /etc/nixos"; # rebuild home-manager
      nixswitch = "sudo nixos-rebuild switch --flake /etc/nixos#automata"; # rebuild nix
      errorlog = "journalctl --user -b -p err | tail"; # tail of errors in journal
      restart-waybar = "systemctl --user restart waybar.service"; # restart waybar
      drybuild = "sudo nixos-rebuild dry-build --flake /etc/nixos#automata"; # nixos dry build
    };
  };

  # obsidi-nyan =^.w.^=
  programs.obsidian = {
    enable = true;

    vaults = {
      notes = {
        target = "Documents/Obsidian";
      };
    };

    defaultSettings = {
      app = {
        alwaysUpdateLinks = true;
        spellcheck = true;
      };

      corePlugins = [
        "backlink"
        "bookmarks"
        "canvas"
        "command-palette"
        "daily-notes"
        "editor-status"
        "file-explorer"
        "file-recovery"
        "global-search"
        "graph"
        "note-composer"
        "outgoing-link"
        "outline"
        "page-preview"
        "slash-command"
        "switcher"
        "tag-pane"
        "templates"
        "word-count"
      ];
    };
  };

  # visual studio
  programs.vscode = {
    enable = true;
    package = pkgs.vscode.fhsWithPackages (
      ps: with ps; [
        nixd
        nixfmt
      ]
    );
  };

  home.stateVersion = stateVersion;
}