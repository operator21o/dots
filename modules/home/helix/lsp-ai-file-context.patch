+    uri.strip_prefix("file://").unwrap_or(uri).to_string()
+}
+
+pub(crate) fn file_name_from_uri(uri: &str) -> String {
+    let file_path = file_path_from_uri(uri);
+
+    Path::new(&file_path)
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or(&file_path)
+        .to_string()
+}
+
+fn display_path_from_uri<'a>(uri: &'a str, root_uri: Option<&str>) -> &'a str {
+    match root_uri {
+        Some(root_uri) if uri.starts_with(root_uri) => &uri[root_uri.chars().count()..],
+        _ => uri,
+    }
+}
+
+pub(crate) fn format_file_header(uri: &str, root_uri: Option<&str>) -> String {
+    format!("--{}--\n", display_path_from_uri(uri, root_uri))
+}
