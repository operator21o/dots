+    async fn get_responses_chat(
+        &self,
+        messages: Vec<ChatMessage>,
+        params: OpenAIRunParams,
+    ) -> anyhow::Result<String> {
+        let client = reqwest::Client::new();
+        let token = self.get_token()?;
+        let mut instructions = None;
+        let mut input = vec![];
+
+        for message in messages {
+            if instructions.is_none() && message.role == "system" {
+                instructions = Some(message.content);
+            } else if !message.content.trim().is_empty() {
+                input.push(message);
+            }
+        }
+
+        let mut request_params = json!({
+            "model": self.configuration.model,
+            "input": input,
+            "max_output_tokens": params.max_tokens
+        });
+        let request_params_object = request_params
+            .as_object_mut()
+            .expect("responses request parameters must be a JSON object");
+
+        if let Some(instructions) = instructions {
+            request_params_object.insert("instructions".to_string(), json!(instructions));
+        }
+
+        if let Some(reasoning_effort) = params.reasoning_effort {
+            request_params_object.insert(
+                "reasoning".to_string(),
+                json!({
+                    "effort": reasoning_effort
+                }),
+            );
+        }
+
+        info!(
+            "Calling OpenAI compatible responses API with parameters:\n{}",
+            serde_json::to_string_pretty(&request_params).unwrap()
+        );
+        let res: OpenAIResponsesResponse = client
+            .post(
+                self.configuration
+                    .chat_endpoint
+                    .as_ref()
+                    .context("must specify `chat_endpoint` to use responses")?,
+            )
+            .bearer_auth(token)
+            .header("Content-Type", "application/json")
+            .header("Accept", "application/json")
+            .json(&request_params)
+            .send()
+            .await?
+            .json()
+            .await?;
+        info!(
+            "Response from OpenAI compatible responses API:\n{}",
+            serde_json::to_string_pretty(&res).unwrap()
+        );
+        match res {
+            OpenAIResponsesResponse::Success(resp) => {
+                if let Some(output_text) = resp.output_text {
+                    if !output_text.trim().is_empty() {
+                        return Ok(output_text);
+                    }
+                }
+
+                if let Some(output) = resp.output {
+                    for item in output {
+                        if let Some(content) = item.content {
+                            for content_item in content {
+                                if let Some(text) = content_item.text {
+                                    if !text.trim().is_empty() {
+                                        return Ok(text);
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+
+                anyhow::bail!("OpenAI compatible responses API returned no text output")
+            }
+            OpenAIResponsesResponse::Error(error) => {
+                anyhow::bail!("making OpenAI responses request: {:?}", error.error.to_string())
+            }
+            OpenAIResponsesResponse::Other(other) => {
+                anyhow::bail!(
+                    "unknown error while making OpenAI responses request: {:?}",
+                    other
+                )
+            }
+        }
+    }
